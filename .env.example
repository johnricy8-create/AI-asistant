# ===== 优选商城智能客服 Copilot =====
# 留空则自动进入本地 Mock 模式，Demo 仍可完整运行。
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_DISABLE_THINKING=true
ZHIPU_MAX_TOKENS=800
ZHIPU_TIMEOUT_SECONDS=10
ZHIPU_TOTAL_TIMEOUT_SECONDS=8
ZHIPU_MAX_RETRIES=2
ZHIPU_RETRY_BACKOFF_SECONDS=1
ZHIPU_COOLDOWN_SECONDS=20
PRIORITY_TOTAL_TIMEOUT_SECONDS=3

# 硅基流动 BGE-M3 / rerank（可选；留空则用本地 Sentence Transformers）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_PROVIDER=siliconflow
RERANK_PROVIDER=siliconflow

# 检索与重排
RETRIEVAL_BACKEND=chroma
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=kb_chunks
RECALL_TOP_K=15
RERANK_TOP_K=5
CONTEXT_TOP_K=5
RERANK_MIN_SCORE=0.10
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# auto: 有 Key 用智谱，没有则 Mock；mock: 强制本地；zhipu: 强制调用（失败会降级）
LLM_MODE=auto

# Demo 使用 SQLite；生产替换为 MySQL。
DATABASE_URL=sqlite:///./data/app.db

# 检索与生成参数
FAQ_THRESHOLD_DEFAULT=0.82
FAQ_MARGIN_DEFAULT=0.03
RAG_MIN_SCORE=0.20
PRIORITY_LARGE_AMOUNT_THRESHOLD=500
MAX_CONTEXT_CHARS=6000
REQUEST_TIMEOUT_SECONDS=30
